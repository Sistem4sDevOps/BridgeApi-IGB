<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="paystub" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dc63626b-5de4-4698-babc-77d9b9a26700">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="year" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="month" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="day" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="nit" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
    t.cedula,
    t.nombre,
    t.apellido1,
    t.apellido2,
    t.correoElectronico,
    t.salarioBasico,
    t.fechaIngreso,
    t.nombreCargo,
    t.nombreBanco,
    t.cuentaBanco,
    t.nombreBanco,
    t.nombreEPS,
    t.pension,
    t.cesantias,
    t.nombreNomina,
    t.periodo,
    t.diasHabiles,
    cast(sum(t.diasLiq) as int) as diasLiq,
    t.cod_con as codigoConceptos,
    t.conceptos,
    CASE WHEN sum(t.debito) <> 0 THEN cast(sum(t.debito) as numeric(18,0)) END as debit,
    CASE WHEN sum(t.credito) <> 0 THEN cast(sum(t.credito) as numeric(18,0)) END as credit
from (
    select distinct
        e.cod_emp as cedula,
        nom_emp as nombre,
        ap1_emp as apellido1,
        ap2_emp as apellido2,
        e_mail as correoElectronico,
        e.sal_bas as salarioBasico,
        cast(fec_ing as date) as fechaIngreso,
        nom_car as nombreCargo,
        cta_ban as cuentaBanco,
        nom_ban as nombreBanco,
        f.nom_fdo as nombreEPS,
        fn.nom_fdo as pension,
        fnd.nom_fdo as cesantias,
        'NOMINA MES DE '+upper(datename(mm, d.fch_doc))+' '+rtrim(cast(year(d.fch_doc) as char(4))) as nombreNomina,
        cast(d.fch_doc as date) as periodo,
        d.deb_mov as debito,
        d.cre_mov as credito,
        (select Dia_per_cau from rhh_ConsVaca where cod_emp = e.cod_emp and year(fec_fin_cau) = $P{year} and month(fec_fin_cau) = $P{month}) as diasHabiles,
        left(rtrim(d.des_con)+replicate(' ',40), 40) as conceptos,
        l.can_liq as diasLiq,
        d.cod_con
    from rhh_emplea e
    inner join rhh_cargos c on e.cod_car = c.cod_car
    inner join gen_bancos b on b.cod_ban = e.cod_ban
    inner join rhh_tbfondos f on f.cod_fdo = e.fdo_sal
    inner join rhh_tbfondos fn on fn.cod_fdo = e.fdo_pen
    inner join rhh_tbfondos fnd on fnd.cod_fdo = e.fdo_ces
    inner join rhh_intconta_detalle d on d.cod_emp = e.cod_emp
    inner join rhh_pagvaca v on d.cod_emp = e.cod_emp
    left join rhh_liqhis l on d.cod_con = l.cod_con
        and d.fec_cte = l.fec_cte
        and d.num_doc = l.num_doc
        and d.cod_emp = l.cod_emp
        and d.idl_num = l.idl_num
        and d.mod_liq = l.mod_liq
        and d.tip_liq = l.tip_liq
        and d.cod_suc = l.cod_suc
        and d.cod_cco = l.cod_cco
        and d.num_doc = l.num_doc
        -- and d.cre_mov = l.val_liq
    where
        e.cod_emp = $P{id}
        and year(d.fch_doc) = $P{year}
        and month(d.fch_doc) = $P{month}
        and day(d.fch_doc) = $P{day}
        and d.des_con <> 'Neto a Pagar'
    group by
        e.cod_emp,
        nom_emp,
        ap1_emp,
        ap2_emp,
        e_mail,
        e.sal_bas,
        fec_ing,
        nom_car,
        cta_ban,
        nom_ban,
        f.nom_fdo,
        fn.nom_fdo,
        fnd.nom_fdo,
        d.fch_doc,
        d.des_con,
        l.can_liq,
        d.deb_mov,
        d.cre_mov,
        d.cod_con,
        v.dia_hab
) as t
group by
    t.conceptos,
    t.cedula,
    t.nombre,
    t.apellido1,
    t.apellido2,
    t.correoElectronico,
    t.salarioBasico,
    t.fechaIngreso,
    t.nombreCargo,
    t.nombreBanco,
    t.cuentaBanco,
    t.nombreBanco,
    t.nombreEPS,
    t.pension,
    t.cesantias,
    t.nombreNomina,
    t.periodo,
    t.cod_con,
    t.diasHabiles
having
    sum(t.debito) - sum(t.credito) <> 0
order by
    case
        when sum(t.debito) > sum(t.credito) then 0 else 1
    end,
    20,
    19 asc;]]>
	</queryString>
