	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"/>
	<variable name="TOTAL_DESCUENTO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[
			($F{ValorDesc} != null && !$F{ValorDesc}.isEmpty())
				? new java.math.BigDecimal(
					String.valueOf($F{ValorDesc})
						.replace(".", "")
						.replace(",", "")
				  ).setScale(0, java.math.RoundingMode.HALF_UP)
				: java.math.BigDecimal.ZERO
		]]></variableExpression>
	</variable>

	<!-- AJUSTADA: respeta decimales con coma o punto -->
	<variable name="TOTAL_PAGO" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[
			($F{ValorPago} != null && !$F{ValorPago}.isEmpty())
				? new java.math.BigDecimal(
					(
						String.valueOf($F{ValorPago}).contains(",")
						? String.valueOf($F{ValorPago}).replace(".", "").replace(",", ".")
						: String.valueOf($F{ValorPago})
					)
				  )
				: java.math.BigDecimal.ZERO
		]]></variableExpression>
	</variable>

