	<queryString>
		<![CDATA[select e.cod_emp as cedula, e.nom_emp as nombre, e.ap1_emp as apellido1, e.ap2_emp as apellido2, e.fec_ing as fechaIngreso, c.nom_car as cargo
from rhh_emplea e
inner join rhh_cargos c ON e.cod_car = c.cod_car
where cod_emp = $P{id}]]>
	</queryString>
